# LM Studio (local inference)
LM_STUDIO_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=llama-3

# OpenAI API (fallback при сбое локальной модели)
OPENAI_API_KEY=sk-...

# ComfyUI (локальная генерация изображений)
COMFYUI_URL=http://127.0.0.1:8188
# Имя checkpoint (обычно задаётся внутри workflow-файла)
COMFYUI_MODEL=
# Путь к txt2img workflow (UI- или API-формат ComfyUI). Пусто = встроенный шаблон
COMFYUI_WORKFLOW_PATH=
# Whitelist: пользовательские пути воркфлоу разрешены только внутри этого каталога
COMFYUI_WORKFLOWS_ROOT=
# Таймаут ожидания генерации ComfyUI, сек
COMFYUI_TIMEOUT=120

# Изображения
IMAGE_GENERATION_ENABLED=true
IMAGE_DEFAULT_STEPS=8
IMAGE_WEBP_QUALITY=82

# Tailwind: компилировать CSS через npm вместо Play CDN
TAILWIND_BUILD_ENABLED=true

# Очередь GPU: максимальное ожидание слота, сек
GENERATION_QUEUE_TIMEOUT=900

# Раздача собранного фронтенда бэкендом (frontend/dist)
SERVE_FRONTEND=true

# Хранилище (по умолчанию backend/../storage). Оставь пустым для дефолта
STORAGE_DIR=

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000
